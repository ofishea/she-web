# Paystack secret key (server-side only — never expose in the browser)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx

# Optional: cap how many pages of transactions to fetch (100 per page)
# Increase if you have a long history; default is 20 pages (2000 txs max)
PAYSTACK_MAX_TRANSACTION_PAGES=20

# Optional: cap transfer list pages (100 per page)
PAYSTACK_MAX_TRANSFER_PAGES=20

# Public site branding
NEXT_PUBLIC_SITE_NAME=Sangotedo Housing Estate
